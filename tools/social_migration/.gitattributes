# Bounded snapshots and hashes preserve exact bytes on all hosts.
reference/** -text
*.py text eol=lf
*.md text eol=lf

# R004 accepted audit bytes override the generic Python newline conversion.
audit_native.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
.gitattributes -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
