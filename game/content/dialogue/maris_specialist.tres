[ext_resource type="Script" path="res://features/dialogue/conversation_definition.gd" id="1"]

[resource]
script = ExtResource("1")
stable_id = "prototype-maris-specialist"
display_name = "Maris — specialist service restored (prototype)"
speaker_actor_id = "npc-03"
prototype_fixture = true
graph_json = "{\"npcId\":\"npc-03\",\"entryNodeIds\":[\"prototype-maris-specialist:intro-0\"],\"nodes\":[{\"id\":\"prototype-maris-specialist:intro-0\",\"text\":\"[Prototype Reed Chandlery] Reconnection and the practical fitting are complete. Specialist fitting service has returned alongside ordinary supplies. Inspect the counter's river gear and repair fittings.\",\"portraitId\":\"official-neutral\",\"presentationIndex\":0,\"choices\":[{\"id\":\"maris-specialist-inspect\",\"text\":\"Inspect the specialist river-gear service.\",\"targetNodeId\":\"maris-specialist-inspect:response-0\",\"command\":{\"action_id\":\"prototype-observe\"}},{\"id\":\"maris-specialist-leave\",\"text\":\"Leave the restored counter.\",\"targetNodeId\":\"maris-specialist-leave:response-0\",\"command\":{\"action_id\":\"prototype-leave\"}}]},{\"id\":\"maris-specialist-inspect:response-0\",\"text\":\"[Prototype service preview] Fitted river gear and repair fittings are available again. Maris can match fittings to a customer's needs; line and lamp oil remain on the basic shelf. This prototype previews service availability, with no purchase or inventory transaction.\",\"portraitId\":\"official-neutral\",\"presentationIndex\":0},{\"id\":\"maris-specialist-leave:response-0\",\"text\":\"Maris's specialist service stays restored. The wider town, closed fair and damaged passenger ship still have their own work ahead.\",\"portraitId\":\"official-neutral\",\"presentationIndex\":0}]}"
