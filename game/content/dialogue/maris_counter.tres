response = PackedStringArray("[Shortened prototype adaptation] The Tollworks refuge holds an experience of fitting river gear for a familiar customer. Walk east into Moonwood, cross the timber bridge or sand ford, then use the glowing forest Tollworks entrance to investigate.")

[sub_resource type="Resource" id="Reconnect"]
