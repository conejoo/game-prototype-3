[gd_resource type="Resource" script_class="ConversationDefinition" format=3]

[ext_resource type="Script" path="res://features/dialogue/conversation_definition.gd" id="1"]

[resource]
script = ExtResource("1")
stable_id = "prototype-maris-counter"
display_name = "Maris — prototype counter adaptation"
speaker_actor_id = "npc-03"
prototype_fixture = true
graph_json = "{\"npcId\":\"npc-03\",\"entryNodeIds\":[\"prototype-maris-counter:intro-0\"],\"nodes\":[{\"id\":\"prototype-maris-counter:intro-0\",\"text\":\"[Prototype adaptation, not the full campaign opening] Maris's specialist fitting judgment is missing. Ordinary supplies remain available. Choose a recovery lead or reconnect after opening her vessel's return path.\",\"portraitId\":\"official-neutral\",\"presentationIndex\":0,\"choices\":[{\"id\":\"maris-lead-choice\",\"text\":\"Accept the recovery lead.\",\"targetNodeId\":\"maris-lead-choice:response-0\",\"command\":{\"action_id\":\"maris-accept-lead\",\"quest_id\":\"prototype-maris-recovery\"}},{\"id\":\"maris-reconnect-choice\",\"text\":\"Support reconnection and a familiar fitting.\",\"targetNodeId\":\"maris-reconnect-choice:response-0\",\"command\":{\"action_id\":\"maris-reconnect\",\"quest_id\":\"prototype-maris-recovery\"}},{\"id\":\"maris-leave-choice\",\"text\":\"Leave the counter.\",\"targetNodeId\":\"maris-leave-choice:response-0\",\"command\":{\"action_id\":\"prototype-leave\"}}]},{\"id\":\"maris-lead-choice:response-0\",\"text\":\"[Shortened prototype adaptation] The Tollworks refuge holds an experience of fitting river gear for a familiar customer. Walk east into Moonwood, cross the timber bridge or sand ford, then use the glowing forest Tollworks entrance to investigate.\",\"portraitId\":\"official-neutral\",\"presentationIndex\":0},{\"id\":\"maris-reconnect-choice:response-0\",\"text\":\"[Prototype adaptation] Recognition and specialist service return through a familiar practical fitting. The passenger ship still needs separate salvage and repairs.\",\"portraitId\":\"official-neutral\",\"presentationIndex\":0},{\"id\":\"maris-leave-choice:response-0\",\"text\":\"You step away. Recovery requires the journey and a return to this counter.\",\"portraitId\":\"official-neutral\",\"presentationIndex\":0}]}"
