graph_json = "{\"npcId\":\"prototype-hero\",\"entryNodeIds\":[\"prototype-marker-inspection:intro-0\"],\"nodes\":[{\"id\":\"prototype-marker-inspection:intro-0\",\"text\":\"[Prototype inspection] A practice marker for testing prop interactions in either room.\",\"portraitId\":\"\",\"presentationIndex\":0,\"choices\":[{\"id\":\"prototype-marker-detail\",\"text\":\"Look closer.\",\"targetNodeId\":\"prototype-marker-detail:response-0\",\"command\":{\"action_id\":\"prototype-observe\"}},{\"id\":\"prototype-marker-leave\",\"text\":\"Leave it alone.\",\"targetNodeId\":\"prototype-marker-leave:response-0\",\"command\":{\"action_id\":\"prototype-leave\"}}]},{\"id\":\"prototype-marker-detail:response-0\",\"text\":\"A replaceable graybox marker. Inspecting it changes no quest, reward, or recovery state.\",\"portraitId\":\"\",\"presentationIndex\":0},{\"id\":\"prototype-marker-leave:response-0\",\"text\":\"You step back from the practice marker.\",\"portraitId\":\"\",\"presentationIndex\":0}]}"
