extends "res://tests/support/fishing_root_fixture.gd"

func _exercise() -> void:
	suite = "session"
	var before: String = _facts()
	game.session.inventory.select(null)
	_key(KEY_F)
	_check(game.fishing.mode() == "idle" and game._fishing_feedback.contains("Select"),"unselected rod rejects F")
	game.session.inventory.select(ForagingRegistry.ROD_ITEM)
	_check(_facts() == before,"selection restored exact baseline")
	_pose(Vector3(-7,0,18))
	_key(KEY_W,true)
	_key(KEY_F)
	_check(game.fishing.mode() == "targeting" and game.player_placeholder.controls_enabled,"targeting permits movement")
	_check(game.player_placeholder.movement_buttons.has("move_forward"),"targeting retains already accepted movement")
	_key(KEY_F,true,true)
	_check(game.fishing.mode() == "targeting","F echo cannot cancel or recast")
	var rng_state: int = game._fishing_rng.state
	_click(Vector2(10,10))
	_check(game.fishing.mode() == "targeting" and game._fishing_rng.state == rng_state and not game.player_placeholder.combat.busy(),"UI click cannot cast/attack/roll")
	_click(game.camera_rig.camera.unproject_position(Vector3(-6.75,.015,18.25)))
	_check(game.fishing.mode() == "targeting" and game._fishing_rng.state == rng_state,"dry deck rejected without RNG")
	_click(game.camera_rig.camera.unproject_position(Vector3(-12.75,.015,20.25)))
	_check(game.fishing.mode() == "targeting" and game._fishing_feedback.contains("No fishing area") and game._fishing_rng.state == rng_state,"no area immediate without encounter/wait draws")
	_check(_facts() == before,"invalid casts alter no durable facts")
	_key(KEY_W,false)
	_key(KEY_B)
	_check(game.backpack_open and game.fishing.mode() == "idle" and not game.fishing_preview.visible,"targeting to backpack cancels safely")
	_key(KEY_B)
	_key(KEY_F)
	game._open_people()
	_check(game.journal_open and game.fishing.mode() == "idle","targeting to journal cancels safely")
	game._close_journal()
	_key(KEY_F)
	_key(KEY_F)
	_cast("")
	var wait: float = game.fishing.snapshot().wait_seconds
	game._tick_fishing(wait-.01)
	_check(game.fishing.active(),"miss has normal wait")
	game._tick_fishing(.01)
	_check(game.fishing.mode() == "idle" and game.fishing.snapshot().outcome == "no_bite" and _facts() == before,"miss resolves no reward")
	_cast()
	_check(game.player_placeholder.movement_buttons.is_empty() and game.player_placeholder.velocity == Vector3.ZERO and not game.player_placeholder.controls_enabled,"attempt clears/locks hero movement")
	_check(game.companion_ai.enabled and game.companion.combat_enabled and game.player_placeholder.combat_enabled,"world/ally/damage simulation stays enabled")
	var foot: Vector3 = game.player_placeholder.global_position
	for key: int in [KEY_W,KEY_SPACE,KEY_B,KEY_J]: _key(key)
	_click(Vector2(500,360))
	game._toggle_backpack()
	game._open_people()
	_check(not game.backpack_open and not game.journal_open and not game.dialogue.active() and not game.player_placeholder.combat.busy() and game.player_placeholder.global_position == foot,"attempt blocks movement/attack/dodge/bag/journal and second cast")
	_check(not game.interact().ok and not game._drag_input_allowed() and not game._save_boundary_errors().is_empty(),"world interactions/drag/save blocked")
	_check(not game.switch_light(null,false).ok,"lamp command blocked")
	var token: int = game.fishing.snapshot().token
	game._toggle_fishing()
	_check(game.fishing.mode() == "idle" and game.fishing.snapshot().token == token,"F cancels single attempt")
	_check(_facts() == before,"cast/cancel conserves rod and all durable facts")
	# Previously eligible preview becomes out of range before cast dispatch.
	_pose(Vector3(-7,0,18))
	var pointer: Vector2 = game.camera_rig.camera.unproject_position(Vector3(-4.75,.015,20.25))
	_pointer(pointer)
	_key(KEY_F)
	game.player_placeholder.global_position = Vector3(-20,0,10)
	var state: int = game._fishing_rng.state
	_click(pointer)
	_check(not game.fishing.active() and game._fishing_rng.state == state,"cast revalidates moved player rather than cached preview")
	game._cancel_fishing("fixture reset")
	_cast()
	_key(KEY_E,true)
	_check(game.fishing.mode() == "idle" and game._fishing_feedback.contains("early") and game._e_down and game._e_consumed,"early E terminates with fresh interaction gate")
	_check(not game.interact().ok,"held E cannot immediately act after exit")
	_key(KEY_E,true,true)
	_check(not game.foraging_hold.active(),"E echo cannot restart interaction")
	_key(KEY_E,false)
	_cast()
	game._tick_fishing(game.fishing.snapshot().wait_seconds+1.2)
	_check(game.fishing.mode() == "idle" and game._fishing_feedback.contains("Missed"),"missed hook distinct")
	_cast()
	var seconds: float = game.session.elapsed_play_seconds
	var day: float = game.session.environment.day_cycle_progress
	game._process(.25)
	_check(game.session.elapsed_play_seconds > seconds and game.session.environment.day_cycle_progress > day and not paused,"active attempt continues world clock/weather")
	_click(Vector2(500,360),MOUSE_BUTTON_RIGHT)
	_check(game.fishing.mode() == "idle" and game.player_placeholder.controls_enabled,"right-click cancel restores controls")
	_phase("fighting")
	game.set_fishing_reel("pointer",true)
	_key(KEY_E,false)
	_check(game.fishing.snapshot().reel_held and game.fishing.snapshot().phase == "fighting","combined pointer source holds after keyboard release; no double hook")
	game.set_fishing_reel("pointer",false)
	_check(not game.fishing.snapshot().reel_held,"all released clears reel")
	game._cancel_fishing("explicit")
	for id: String in FISH:
		_cast(id)
		_land()
