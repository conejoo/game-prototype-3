; Engine configuration file. Edit through Godot when practical.
config_version=5

[application]
config/name="Returning Fair — Prototype"
run/main_scene="res://app/game_root.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=640
window/stretch/mode="canvas_items"

[editor]
export/convert_text_resources_to_binary=false

[input]
fishing={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":70)]
}
backpack={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":66)]
}
debug_advance_hour={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194337)]
}
retry={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":82)]
}
journal={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":74)]
}
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":68)]
}
attack={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
dodge={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194305)]
}
quit={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194341)]
}
camera_projection={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":80)]
}
zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4), Object(InputEventKey,"keycode":61), Object(InputEventKey,"keycode":43)]
}
zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5), Object(InputEventKey,"keycode":45)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.095, 1)
