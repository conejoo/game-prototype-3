# M002 snapshot hashes refer to the original bytes, including source line endings.
tools/map_migration/reference/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Keep extractor/generated hashes stable across Windows and Unix checkouts.
tools/map_migration/extract_layout.py text eol=lf
tools/map_migration/extraction_report.json text eol=lf
game/content/maps/alderwake_layout.json text eol=lf

# M017 historical-save provenance hashes refer to exact captured bytes.
game/tests/fixtures/map_saves/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Exact weather reference hashes survive Windows and Unix checkouts.
docs/weather-lighting/reference/*.dart -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/weather-lighting/reference/*.json text eol=lf
game/tests/fixtures/map_camera_poses.json text eol=lf
